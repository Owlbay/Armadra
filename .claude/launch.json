{
  "version": "0.0.1",
  "configurations": [
    {
      "$comment": "This entry pins a port because a launch configuration cannot read endpoints.json before the process exists. It is declared with --listen rather than relying on core's compatibility default, and the web entries below reach core through the Vite proxy, which does read endpoints.json. Build the core bundle first with `pnpm --filter @armadra/desktop build`.",
      "name": "core",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/desktop/out/core/main.js",
        "--listen",
        "tcp:127.0.0.1:43124"
      ],
      "port": 43124,
      "url": "http://127.0.0.1:43124"
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@armadra/web",
        "dev",
        "--port",
        "1421",
        "--host",
        "localhost"
      ],
      "port": 1421,
      "url": "http://localhost:1421"
    },
    {
      "name": "web-review",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@armadra/web",
        "dev",
        "--port",
        "1422",
        "--host",
        "localhost"
      ],
      "port": 1422,
      "url": "http://localhost:1422"
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@armadra/web",
        "exec",
        "vite",
        "preview",
        "--port",
        "1423",
        "--host",
        "localhost"
      ],
      "port": 1423,
      "url": "http://localhost:1423"
    },
    {
      "$comment": "界面审查用：隔离数据目录，不碰本机真实数据。",
      "name": "core-ui-review",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/desktop/out/core/main.js",
        "--listen",
        "tcp:127.0.0.1:43125"
      ],
      "env": {
        "ARMADRA_DATA_DIR": "/tmp/armadra-ui-review"
      },
      "port": 43125,
      "url": "http://127.0.0.1:43125"
    },
    {
      "name": "web-ui-review",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@armadra/web",
        "dev",
        "--port",
        "1424",
        "--host",
        "localhost"
      ],
      "env": {
        "ARMADRA_DATA_DIR": "/tmp/armadra-ui-review"
      },
      "port": 1424,
      "url": "http://localhost:1424"
    }
  ]
}
