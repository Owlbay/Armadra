# dev-stack 的 armadra-server 占位镜像（G3-5 的正式 Dockerfile 到位前用）。
#
# 构建上下文是仓库根：服务器壳直接引用 apps/desktop/src/core，页面产物来自
# apps/web，单独拿 apps/server 一个目录造不出来。只给本机 dev-stack 用，
# 不发布、不签名；正式镜像的多阶段与非 root 用户由 G3-5 负责。
FROM node:22.23.3-bookworm-slim

ENV CI=1 \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    # 打包后的 out/main.js 把 node-pty 留作外部模块，从桌面包的依赖里找。
    NODE_PATH=/src/apps/desktop/node_modules

WORKDIR /src
# node-pty 在 Linux 上没有预编译产物，要按 Node ABI 现编一份（ensure-node-pty.mjs）。
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/* \
 && corepack enable

COPY . .
RUN pnpm install --frozen-lockfile \
 && pnpm libs:build \
 && pnpm --filter @armadra/web build \
 && pnpm --filter @armadra/server build \
 && node apps/desktop/scripts/ensure-node-pty.mjs --prebuilt

EXPOSE 8443
ENTRYPOINT ["node", "apps/server/out/main.js"]
CMD ["serve", "--data-dir", "/data", "--listen", "0.0.0.0:8443", "--public-origin", "https://localhost:8443"]
