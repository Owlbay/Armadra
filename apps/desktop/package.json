{
  "name": "@armadra/desktop",
  "description": "Armadra desktop shell",
  "homepage": "https://github.com/yovinchen/Armadra",
  "author": {
    "name": "YoVinchen",
    "email": "gzh298255@gmail.com"
  },
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "desktopName": "armadra.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/launch-exe.mjs --if-windows",
    "predev": "node scripts/ensure-electron.mjs",
    "dist": "node scripts/dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/ensure-node-pty.mjs",
    "test": "vitest run && vitest run --config vitest.live.config.mts && node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@sentry/electron": "7.20.0",
    "@simplewebauthn/server": "14.0.3",
    "acme-client": "5.4.0",
    "electron-updater": "6.8.9",
    "lib0": "0.2.119",
    "node-pty": "1.1.0",
    "otplib": "13.5.0",
    "ws": "8.18.3",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@armadra/agent": "0.6.7",
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "42.11.6",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "js-yaml": "5.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
