import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
import {
  act,
  cleanup,
  fireEvent,
  render,
  screen,
  waitFor,
} from "@testing-library/react";

import { usePreferencesStore } from "../app/preferences-store";
import { ChallengeSheet } from "../mobile/ChallengeSheet";
import { ChallengeFrame } from "./ChallengeFrame";
import { ChallengePage, isChallengePath } from "./ChallengePage";
import {
  CHALLENGE_MESSAGE,
  challengeFrameUrl,
  isChallengeMessage,
  isChallengeStatus,
  type TurnstileApi,
} from "./turnstile";

const ISSUER = "https://relay.example";

/** 假的 Turnstile：记下 render 的参数，测试里手动「通过」。 */
function fakeTurnstile() {
  const state: { callbacks: Array<(token: string) => void> } = {
    callbacks: [],
  };
  const api: TurnstileApi = {
    render: vi.fn((_el, options) => {
      state.callbacks.push(options.callback);
      return `w${state.callbacks.length}`;
    }),
    remove: vi.fn(),
  };
  return {
    api,
    load: async () => api,
    pass: (token: string) => state.callbacks.at(-1)!(token),
  };
}

beforeEach(() => {
  usePreferencesStore.setState({ locale: "zh-CN" });
});
afterEach(() => {
  cleanup();
  vi.useRealTimers();
});

/** 以内嵌的挑战页（或别的窗口）的身份给面板发消息。 */
function post(
  data: unknown,
  origin: string,
  source: Window | null = document.querySelector("iframe")?.contentWindow ??
    null,
) {
  act(() => {
    window.dispatchEvent(new MessageEvent("message", { data, origin, source }));
  });
}

describe("挑战面板内容", () => {
  it("页面就在中继来源上：直接渲染 Turnstile，令牌交给调用方", async () => {
    const fake = fakeTurnstile();
    const onToken = vi.fn();
    render(
      <ChallengeFrame
        issuer={`${ISSUER}/`}
        origin={ISSUER}
        siteKey="0xSITE"
        onToken={onToken}
        load={fake.load}
      />,
    );
    await waitFor(() => expect(fake.api.render).toHaveBeenCalled());
    expect(vi.mocked(fake.api.render).mock.calls[0]![1]).toMatchObject({
      sitekey: "0xSITE",
    });
    fake.pass("tk-1");
    expect(onToken).toHaveBeenCalledWith("tk-1");
    expect(document.querySelector("iframe")).toBeNull();
  });

  it("别的来源：内嵌中继的挑战页，只认这个 iframe、来自中继来源的令牌消息", () => {
    const onToken = vi.fn();
    render(
      <ChallengeFrame
        issuer={ISSUER}
        origin="capacitor://localhost"
        siteKey="0xSITE"
        onToken={onToken}
      />,
    );
    const frame = document.querySelector("iframe")!;
    const url = new URL(frame.getAttribute("src")!);
    expect(url.origin).toBe(ISSUER);
    expect(url.pathname).toBe("/app/challenge");
    expect(url.searchParams.get("siteKey")).toBe("0xSITE");
    expect(url.searchParams.get("parent")).toBe("capacitor://localhost");
    const message = { type: CHALLENGE_MESSAGE, token: "tk-2" };
    post(message, "https://evil.example");
    post({ type: "x", token: "t" }, ISSUER);
    // 来源对、但不是这个 iframe 发的（同一中继的另一个窗口）。
    post(message, ISSUER, window);
    expect(onToken).not.toHaveBeenCalled();
    post(message, ISSUER);
    expect(onToken).toHaveBeenCalledWith("tk-2");
  });

  it("挑战页报 ready 之前 iframe 不显示；父组件重渲染不让 iframe 重载", () => {
    const props = {
      issuer: ISSUER,
      origin: "http://127.0.0.1:5173",
      siteKey: "0xSITE",
    };
    const { rerender } = render(
      <ChallengeFrame {...props} onToken={vi.fn()} />,
    );
    const frame = document.querySelector("iframe")!;
    const src = frame.getAttribute("src");
    expect(frame.className).toContain("invisible");
    expect(screen.getByLabelText("正在加载")).toBeTruthy();
    post({ type: CHALLENGE_MESSAGE, status: "ready" }, ISSUER);
    expect(frame.className).not.toContain("invisible");
    expect(screen.queryByLabelText("正在加载")).toBeNull();
    // 调用方每次渲染都给新的回调（设置页就是这样）：同一个 iframe 元素、同一个地址。
    for (let i = 0; i < 5; i += 1)
      rerender(<ChallengeFrame {...props} onToken={vi.fn()} />);
    expect(document.querySelector("iframe")).toBe(frame);
    expect(frame.getAttribute("src")).toBe(src);
  });

  it("挑战页一直不报到（被 frame-ancestors 拦下）：一次「加载失败 / 重试」，不自己重试", () => {
    vi.useFakeTimers();
    render(
      <ChallengeFrame
        issuer={ISSUER}
        origin="http://127.0.0.1:5173"
        siteKey="k"
        onToken={vi.fn()}
        readyTimeoutMs={1_000}
      />,
    );
    act(() => vi.advanceTimersByTime(1_000));
    expect(screen.getByRole("alert").textContent).toBe("验证没能加载");
    expect(document.querySelector("iframe")).toBeNull();
    // 停在失败上：再等多久也不会自己重挂 iframe。
    act(() => vi.advanceTimersByTime(60_000));
    expect(document.querySelector("iframe")).toBeNull();
    fireEvent.click(screen.getByRole("button", { name: "重试" }));
    expect(document.querySelectorAll("iframe")).toHaveLength(1);
    expect(screen.queryByRole("alert")).toBeNull();
    post({ type: CHALLENGE_MESSAGE, status: "ready" }, ISSUER);
    act(() => vi.advanceTimersByTime(60_000));
    expect(screen.queryByRole("alert")).toBeNull();
  });

  it("挑战页报 error：换成加载失败", () => {
    render(
      <ChallengeFrame
        issuer={ISSUER}
        origin="http://127.0.0.1:5173"
        siteKey="k"
        onToken={vi.fn()}
      />,
    );
    post({ type: CHALLENGE_MESSAGE, status: "ready" }, ISSUER);
    post({ type: CHALLENGE_MESSAGE, status: "error" }, ISSUER);
    expect(screen.getByRole("alert").textContent).toBe("验证没能加载");
  });

  it("组件载不进来：给重试，重试重新渲染", async () => {
    const fake = fakeTurnstile();
    const load = vi
      .fn<() => Promise<TurnstileApi>>()
      .mockRejectedValueOnce(new Error("blocked"))
      .mockImplementation(fake.load);
    render(
      <ChallengeFrame
        issuer={ISSUER}
        origin={ISSUER}
        siteKey="k"
        onToken={vi.fn()}
        load={load}
      />,
    );
    await screen.findByText("验证没能加载");
    fireEvent.click(screen.getByRole("button", { name: "重试" }));
    await waitFor(() => expect(fake.api.render).toHaveBeenCalled());
  });
});

describe("ChallengeSheet", () => {
  it("底部面板里放着挑战；取消（Esc）通知调用方", async () => {
    const fake = fakeTurnstile();
    const onToken = vi.fn();
    const onCancel = vi.fn();
    render(
      <ChallengeSheet
        open
        issuer={ISSUER}
        origin={ISSUER}
        siteKey="k"
        onToken={onToken}
        onCancel={onCancel}
        load={fake.load}
      />,
    );
    expect(screen.getByText("人机验证")).toBeTruthy();
    await waitFor(() => expect(fake.api.render).toHaveBeenCalled());
    fake.pass("tk-3");
    expect(onToken).toHaveBeenCalledWith("tk-3");
    fireEvent.keyDown(document.activeElement ?? document.body, {
      key: "Escape",
    });
    expect(onCancel).toHaveBeenCalled();
  });
});

describe("挑战页 /app/challenge", () => {
  it("令牌只发给 parent 指明的来源", async () => {
    const fake = fakeTurnstile();
    window.turnstile = fake.api;
    const post = vi.fn();
    render(
      <ChallengePage
        search="?siteKey=0xSITE&parent=capacitor%3A%2F%2Flocalhost"
        post={post}
      />,
    );
    await waitFor(() => expect(fake.api.render).toHaveBeenCalled());
    expect(post).toHaveBeenCalledWith(
      { type: CHALLENGE_MESSAGE, status: "ready" },
      "capacitor://localhost",
    );
    // 失败不让 Turnstile 自己反复重来（面板会闪），交给嵌它的面板。
    expect(vi.mocked(fake.api.render).mock.calls[0]![1]).toMatchObject({
      retry: "never",
    });
    fake.pass("tk-4");
    expect(post).toHaveBeenCalledWith(
      { type: CHALLENGE_MESSAGE, token: "tk-4" },
      "capacitor://localhost",
    );
    delete window.turnstile;
  });

  it("组件判定失败：报 error 给 parent", async () => {
    window.turnstile = {
      render: (_el, options) => {
        queueMicrotask(() => options["error-callback"]?.());
        return "w";
      },
      remove: vi.fn(),
    };
    const post = vi.fn();
    render(
      <ChallengePage
        search="?siteKey=k&parent=http%3A%2F%2F127.0.0.1%3A5173"
        post={post}
      />,
    );
    await waitFor(() =>
      expect(post).toHaveBeenCalledWith(
        { type: CHALLENGE_MESSAGE, status: "error" },
        "http://127.0.0.1:5173",
      ),
    );
    delete window.turnstile;
  });

  it("缺 siteKey 或 parent：什么也不渲染", () => {
    const { container } = render(
      <ChallengePage search="?siteKey=k" post={vi.fn()} />,
    );
    expect(container.textContent).toBe("");
  });
});

describe("小工具", () => {
  it("路径、地址与消息形状", () => {
    expect(isChallengePath("/app/challenge")).toBe(true);
    expect(isChallengePath("/app/")).toBe(false);
    expect(challengeFrameUrl(ISSUER, "k 1", "https://a.b")).toBe(
      `${ISSUER}/app/challenge?siteKey=k+1&parent=https%3A%2F%2Fa.b`,
    );
    expect(isChallengeMessage({ type: CHALLENGE_MESSAGE, token: "t" })).toBe(
      true,
    );
    expect(isChallengeMessage({ type: CHALLENGE_MESSAGE, token: "" })).toBe(
      false,
    );
    expect(isChallengeMessage(null)).toBe(false);
    expect(
      isChallengeStatus({ type: CHALLENGE_MESSAGE, status: "ready" }),
    ).toBe(true);
    expect(isChallengeStatus({ type: CHALLENGE_MESSAGE, status: "x" })).toBe(
      false,
    );
    expect(isChallengeStatus({ type: CHALLENGE_MESSAGE, token: "t" })).toBe(
      false,
    );
  });
});
