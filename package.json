{
  "name": "armadra",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "plugin:build": "node tools/plugins/build-armadra.mjs",
    "plugin:test": "node --test tools/plugins/*.test.mjs",
    "controller:probe": "node tools/probes/controller-smoke.mjs",
    "controller:real:test": "node --test tools/probes/controller-real.test.mjs",
    "controller:real:preflight": "node tools/probes/controller-real.mjs --preflight",
    "repo:check": "node tools/repo-check.mjs",
    "repo:test": "node --test tools/repo-check.test.mjs tools/lint-config.test.mjs tools/contract/generate.test.mjs",
    "contract": "node tools/contract/generate.mjs",
    "contract:check": "node tools/contract/generate.mjs --check",
    "ci:workflows": "node tools/ci/validate-workflows.mjs",
    "release:check": "node tools/release/version.mjs check",
    "notices": "node tools/notices.mjs",
    "notices:check": "node tools/notices.mjs --check",
    "release:dry-run": "node tools/release/dry-run.mjs",
    "release:test": "node --test tools/release/*.test.mjs tools/notices.test.mjs tools/ci/*.test.mjs tools/dev-stack/*.test.mjs tools/probes/server-perf.test.mjs tools/probes/language-load.test.mjs tools/probes/terminal-memory.test.mjs tools/probes/windows-acceptance.test.mjs tools/probes/agent-e2e/*.test.mjs",
    "dev-stack": "node tools/dev-stack/dev-stack.mjs",
    "platform:up": "node tools/dev-stack/dev-stack.mjs up --profile platform",
    "platform:down": "node tools/dev-stack/dev-stack.mjs down --profile platform",
    "platform:health": "node tools/dev-stack/dev-stack.mjs health --profile platform",
    "platform:personal": "node tools/dev-stack/dev-stack.mjs up --profile personal",
    "platform:e2e": "node tools/dev-stack/platform-e2e.mjs",
    "postinstall": "node apps/desktop/scripts/ensure-node-pty.mjs --executable-only",
    "libs:build": "pnpm --filter @armadra/shared build && node apps/desktop/scripts/ensure-node-pty.mjs --executable-only",
    "check": "pnpm libs:build && pnpm contract:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm repo:check && pnpm ci:workflows && pnpm release:check && pnpm notices:check",
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @armadra/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "knip": "knip --no-progress --no-exit-code",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm --filter @armadra/web --filter @armadra/desktop --filter @armadra/server exec vitest run --coverage",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@orpc/openapi": "1.15.4",
    "@orpc/zod": "1.15.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "knip": "6.39.0",
    "playwright-core": "1.63.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
